gitignore_content = """## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file is specific to ASP.NET / .NET Core projects.

# [Visual Studio]
.vs/
*.user
*.userosscache
*.sln.docstates

# [Build results]
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]est[Rr]esults/

# [Publishing]
*.pubxml
*.pubxml.user
*.publishsettings
/publish/

# [User-specific files]
*.suo
*.user
*.userosscache
*.sln.docstates
*.cache
*.userprefs

# [ASP.NET Core]
appsettings.Development.json
UserSecrets/
.templateengine/

# [Node.js (if using Spa Templates)]
node_modules/
npm-debug.log
/ClientApp/dist/
/ClientApp/out/

# [Operating System]
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# macOS
.DS_Store

# [Common tools]
.ionide/
.history/
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
"""

with open(".gitignore", "w") as f:
    f.write(gitignore_content)